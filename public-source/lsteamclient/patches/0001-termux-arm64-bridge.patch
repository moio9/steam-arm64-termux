+static bridge_mm_proxy_query *bridge_mm_find( uint32_t id )
+{
+    if (!id) return NULL;
+    for (size_t i = 0; i < ARRAY_SIZE(bridge_mm_queries); ++i)
+        if (bridge_mm_queries[i].id == id) return &bridge_mm_queries[i];
+    return NULL;
+}
+
+static bridge_mm_proxy_query *bridge_mm_free_slot(void)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(bridge_mm_queries); ++i)
+        if (!bridge_mm_queries[i].id) return &bridge_mm_queries[i];
+    return NULL;
+}
+
+static bool bridge_mm_rpc( uint16_t opcode, lsteam_bridge_mm_request *mm,
+                           lsteam_bridge_mm_response *response )
+{
+    static uint32_t next_sequence = 40000;
+    const char *path;
+    int fd;
+    if (!bridge_rpc_connect( &fd, &path )) return false;
+    lsteam_bridge_request request = { LSTEAM_BRIDGE_MAGIC, LSTEAM_BRIDGE_VERSION,
+        opcode, __atomic_add_fetch( &next_sequence, 1, __ATOMIC_RELAXED ) };
+    memset( response, 0, sizeof(*response) );
+    bool ok = send( fd, &request, sizeof(request), MSG_NOSIGNAL ) == sizeof(request) &&
+              send( fd, mm, sizeof(*mm), MSG_NOSIGNAL ) == sizeof(*mm) &&
+              recv( fd, response, sizeof(*response), 0 ) == sizeof(*response);
+    close( fd );
+    ok = ok && response->magic == LSTEAM_BRIDGE_MAGIC &&
+         response->version == LSTEAM_BRIDGE_VERSION &&
+         response->opcode == opcode && response->sequence == request.sequence &&
+         !response->status && response->data_size <= sizeof(response->data);
+    if (!ok) bridge_trace( "Matchmaking opcode=%u method=%u query=%u failed status=%d",
+                           opcode, mm->method, mm->query_id, response->status );
+    return ok;
+}
+
+static void bridge_mm_dispatch( const lsteam_bridge_mm_response *response )
+{
+    bridge_mm_proxy_query *query = bridge_mm_find( response->query_id );
+    if (!query || !response->event_kind) return;
+    bool retire = response->event_kind == 4 || response->event_kind == 5 ||
+                  response->event_kind == 7 || response->event_kind == 8 ||
+                  response->event_kind == 10 || response->event_kind == 11;
+    if (!query->callback.opaque)
+    {
+        if (retire) memset( query, 0, sizeof(*query) );
+        return;
+    }
+    switch (response->event_kind)
+    {
+    case 1:
+        query->callback.list->ServerResponded( query->handle, response->event_index );
+        break;
+    case 2:
+        query->callback.list->ServerFailedToRespond( query->handle, response->event_index );
+        break;
+    case 3:
+        query->callback.list->RefreshComplete( query->handle, response->event_response );
+        break;
+    case 4:
+    {
+        gameserveritem_t_165 server = {};
+        size_t size = response->data_size < sizeof(server) ?
+                      response->data_size : sizeof(server);
+        if (size) memcpy( &server, response->data, size );
+        query->callback.ping->ServerResponded( &server );
+        break;
+    }
+    case 5:
+        query->callback.ping->ServerFailedToRespond();
+        break;
+    case 6:
+    {
+        float time_played = 0.0f;
+        memcpy( &time_played, &response->event_response, sizeof(time_played) );
+        char name[LSTEAM_BRIDGE_MM_DATA_SIZE];
+        memcpy( name, response->data, sizeof(name) );
+        name[sizeof(name) - 1] = 0;
+        query->callback.players->AddPlayerToList( name, response->event_index,
+                                                  time_played );
+        break;
+    }
+    case 7:
+        query->callback.players->PlayersFailedToRespond();
+        break;
+    case 8:
+        query->callback.players->PlayersRefreshComplete();
+        break;
+    case 9:
+    {
+        constexpr size_t half = LSTEAM_BRIDGE_MM_DATA_SIZE / 2;
+        char rule[half], value[half];
+        memcpy( rule, response->data, half );
+        memcpy( value, response->data + half, half );
+        rule[half - 1] = value[half - 1] = 0;
+        query->callback.rules->RulesResponded( rule, value );
+        break;
+    }
+    case 10:
+        query->callback.rules->RulesFailedToRespond();
+        break;
+    case 11:
+        query->callback.rules->RulesRefreshComplete();
+        break;
+    }
+    if (retire) memset( query, 0, sizeof(*query) );
+}
+
+static void *bridge_mm_request( uint32_t method, uint32_t appid,
+                                MatchMakingKeyValuePair_t **filters,
+                                uint32_t filter_count,
+                                u_ISteamMatchmakingServerListResponse_106 *callback )
+{
+    bridge_mm_proxy_query *query = bridge_mm_free_slot();
+    if (!query || filter_count > LSTEAM_BRIDGE_MAX_MM_FILTERS) return NULL;
+    lsteam_bridge_mm_request mm = {};
+    lsteam_bridge_mm_response response = {};
+    mm.method = method;
+    mm.app_id = appid;
+    mm.filter_count = filter_count;
+    for (uint32_t i = 0; i < filter_count; ++i)
+    {
+        if (!filters || !filters[i]) continue;
+        snprintf( mm.filters[i].key, sizeof(mm.filters[i].key), "%.*s",
+                  (int)sizeof(mm.filters[i].key) - 1, filters[i]->m_szKey );
+        snprintf( mm.filters[i].value, sizeof(mm.filters[i].value), "%.*s",
+                  (int)sizeof(mm.filters[i].value) - 1, filters[i]->m_szValue );
+    }
+    if (!bridge_mm_rpc( LSTEAM_BRIDGE_MATCHMAKING_REQUEST, &mm, &response ) ||
+        !response.query_id) return NULL;
+    memset( query, 0, sizeof(*query) );
+    query->id = response.query_id;
+    query->type = 1;
+    query->handle = (void *)(uintptr_t)response.query_id;
+    query->callback.list = callback;
+    bridge_trace( "Matchmaking request method=%u appid=%u query=%u count=%d refreshing=%u",
+                  method, appid, query->id, response.server_count,
+                  response.refreshing );
+    bridge_mm_dispatch( &response );
+    return query->handle;
+}
+
+static void *bridge_mm_request_internet( void *, uint32_t appid,
+                                         MatchMakingKeyValuePair_t **filters,
+                                         uint32_t count,
+                                         u_ISteamMatchmakingServerListResponse_106 *callback )
+{
+    return bridge_mm_request( 0, appid, filters, count, callback );
+}
+
+static void *bridge_mm_request_lan( void *, uint32_t appid,
+                                    u_ISteamMatchmakingServerListResponse_106 *callback )
+{
+    return bridge_mm_request( 1, appid, NULL, 0, callback );
+}
+
+#define BRIDGE_MM_REQUEST(name, method) \
+    static void *name( void *, uint32_t appid, MatchMakingKeyValuePair_t **filters, \
+                       uint32_t count, u_ISteamMatchmakingServerListResponse_106 *callback ) \
+    { return bridge_mm_request( method, appid, filters, count, callback ); }
+BRIDGE_MM_REQUEST(bridge_mm_request_friends, 2)
+BRIDGE_MM_REQUEST(bridge_mm_request_favorites, 3)
+BRIDGE_MM_REQUEST(bridge_mm_request_history, 4)
+BRIDGE_MM_REQUEST(bridge_mm_request_spectator, 5)
+#undef BRIDGE_MM_REQUEST
+
+static bool bridge_mm_call( uint32_t method, void *handle, int32_t argument,
+                            lsteam_bridge_mm_response *response )
+{
+    lsteam_bridge_mm_request mm = {};
+    mm.method = method;
+    mm.query_id = (uint32_t)(uintptr_t)handle;
+    mm.argument = argument;
+    if (!bridge_mm_rpc( LSTEAM_BRIDGE_MATCHMAKING_CALL, &mm, response )) return false;
+    bridge_mm_dispatch( response );
+    return true;
+}
+
+static void bridge_mm_release( void *, void *handle )
+{
+    lsteam_bridge_mm_response response = {};
+    bridge_mm_proxy_query *query = bridge_mm_find( (uint32_t)(uintptr_t)handle );
+    if (!query) return;
+    bridge_mm_call( 6, handle, 0, &response );
+    memset( query, 0, sizeof(*query) );
+}
+
+static gameserveritem_t_105 *bridge_mm_details( void *, void *handle, int32_t server )
+{
+    static_assert( sizeof(gameserveritem_t_105) == LSTEAM_BRIDGE_MM_ITEM_SIZE,
+                   "SteamMatchMakingServers002 item ABI changed" );
+    lsteam_bridge_mm_response response = {};
+    bridge_mm_proxy_query *query = bridge_mm_find( (uint32_t)(uintptr_t)handle );
+    if (!query || !bridge_mm_call( 7, handle, server, &response ) ||
+        response.data_size != sizeof(query->details)) return NULL;
+    memcpy( &query->details, response.data, sizeof(query->details) );
+    return &query->details;
+}
+
+static void bridge_mm_cancel( void *, void *handle )
+{
+    lsteam_bridge_mm_response response = {};
+    if (!bridge_mm_find( (uint32_t)(uintptr_t)handle )) return;
+    bridge_mm_call( 8, handle, 0, &response );
+}
+
+static void bridge_mm_refresh( void *, void *handle )
+{
+    lsteam_bridge_mm_response response = {};
+    if (!bridge_mm_find( (uint32_t)(uintptr_t)handle )) return;
+    bridge_mm_call( 9, handle, 0, &response );
+}
+
+static int8_t bridge_mm_is_refreshing( void *, void *handle )
+{
+    lsteam_bridge_mm_response response = {};
+    if (!bridge_mm_find( (uint32_t)(uintptr_t)handle )) return 0;
+    return bridge_mm_call( 10, handle, 0, &response ) && response.refreshing;
+}
+
+static int32_t bridge_mm_count( void *, void *handle )
+{
+    lsteam_bridge_mm_response response = {};
+    if (!bridge_mm_find( (uint32_t)(uintptr_t)handle )) return 0;
+    return bridge_mm_call( 11, handle, 0, &response ) ? response.server_count : 0;
+}
+
+static void bridge_mm_refresh_server( void *, void *handle, int32_t server )
+{
+    lsteam_bridge_mm_response response = {};
+    if (!bridge_mm_find( (uint32_t)(uintptr_t)handle )) return;
+    bridge_mm_call( 12, handle, server, &response );
+}
+
+static int32_t bridge_mm_direct_request( uint32_t method, uint32_t ip,
+                                         uint16_t port, void *callback )
+{
+    bridge_mm_proxy_query *query = bridge_mm_free_slot();
+    if (!query) return -1;
+    lsteam_bridge_mm_request mm = {};
+    lsteam_bridge_mm_response response = {};
+    mm.method = method;
+    mm.app_id = ip;
+    mm.query_id = port;
+    if (!bridge_mm_rpc( LSTEAM_BRIDGE_MATCHMAKING_REQUEST, &mm, &response ) ||
+        !response.query_id) return -1;
+    memset( query, 0, sizeof(*query) );
+    query->id = response.query_id;
+    query->type = method;
+    query->handle = (void *)(uintptr_t)response.query_id;
+    query->callback.opaque = callback;
+    bridge_trace( "Matchmaking direct method=%u ip=%u port=%u query=%u",
+                  method, ip, port, query->id );
+    bridge_mm_dispatch( &response );
+    return (int32_t)response.query_id;
+}
+
+static int32_t bridge_mm_ping( void *, uint32_t ip, uint16_t port,
+                               u_ISteamMatchmakingPingResponse *callback )
+{
+    return bridge_mm_direct_request( 13, ip, port, callback );
+}
+
+static int32_t bridge_mm_players( void *, uint32_t ip, uint16_t port,
+                                  u_ISteamMatchmakingPlayersResponse *callback )
+{
+    return bridge_mm_direct_request( 14, ip, port, callback );
+}
+
+static int32_t bridge_mm_rules( void *, uint32_t ip, uint16_t port,
+                                u_ISteamMatchmakingRulesResponse *callback )
+{
+    return bridge_mm_direct_request( 15, ip, port, callback );
+}
+
+static void bridge_mm_cancel_server( void *, int32_t handle )
+{
+    uint32_t id = (uint32_t)handle;
+    bridge_mm_proxy_query *query = bridge_mm_find( id );
+    lsteam_bridge_mm_response response = {};
+    bridge_mm_call( 16, (void *)(uintptr_t)id, 0, &response );
+    if (query) memset( query, 0, sizeof(*query) );
+}
+
+static void bridge_mm_pump(void)
+{
+    uint32_t ids[16];
+    size_t count = 0;
+    for (size_t i = 0; i < ARRAY_SIZE(bridge_mm_queries); ++i)
+        if (bridge_mm_queries[i].id) ids[count++] = bridge_mm_queries[i].id;
+    for (size_t i = 0; i < count; ++i)
+    {
+        bridge_mm_proxy_query *query = bridge_mm_find( ids[i] );
+        if (!query) continue;
+        lsteam_bridge_mm_request mm = {};
+        lsteam_bridge_mm_response response = {};
+        mm.method = 17;
+        mm.query_id = ids[i];
+        if (bridge_mm_rpc( LSTEAM_BRIDGE_MATCHMAKING_CALL, &mm, &response ))
+            bridge_mm_dispatch( &response );
+    }
+}
diff --git a/lsteamclient/bridge_networking_messages_proxy.inc b/lsteamclient/bridge_networking_messages_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..11cd6ed10d7e3208b70374310ee402b1dc4a6426
--- /dev/null
+++ b/lsteamclient/bridge_networking_messages_proxy.inc
@@ -0,0 +1,182 @@
+/* Bionic-side SteamNetworkingMessages002 proxy. */
+static_assert( sizeof(SteamNetworkingIdentity_144) == 136,
+               "unexpected bridge identity ABI" );
+
+static bool bridge_network_messages_rpc(
+    lsteam_bridge_game_server_request *request,
+    lsteam_bridge_game_server_response *response )
+{
+    return bridge_iface_rpc( LSTEAM_BRIDGE_NETWORK_MESSAGES_CALL,
+                             request, response );
+}
+
+static uint32_t bridge_network_messages_send(
+    void *, const SteamNetworkingIdentity_144 *identity, const void *data,
+    uint32_t size, int32_t flags, int32_t channel )
+{
+    if (!identity || (size && !data) || size > 16u * 1024u * 1024u)
+        return 2; /* k_EResultFail */
+    uint32_t offset = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        uint32_t prefix = offset ? 0 : sizeof(*identity);
+        uint32_t chunk = size - offset;
+        if (chunk > sizeof(request.data) - prefix)
+            chunk = sizeof(request.data) - prefix;
+        request.method = 0;
+        request.arg0 = flags;
+        request.arg1 = channel;
+        request.arg2 = size;
+        request.arg3 = offset;
+        request.data_size = prefix + chunk;
+        if (prefix) memcpy( request.data, identity, prefix );
+        if (chunk) memcpy( request.data + prefix,
+                           (const uint8_t *)data + offset, chunk );
+        if (!bridge_network_messages_rpc( &request, &response )) return 2;
+        offset += chunk;
+        if (offset == size) return response.result;
+    } while (offset < size);
+    return 2;
+}
+
+static void U_CDECL bridge_network_messages_release(
+    u_SteamNetworkingMessage_t_153a *message )
+{
+    if (!message) return;
+    free( message->m_pData );
+    free( message );
+}
+
+static u_SteamNetworkingMessage_t_153a *bridge_network_messages_read_one(
+    int32_t channel )
+{
+    const uint32_t header_size = sizeof(lsteam_bridge_network_message_header);
+    lsteam_bridge_network_message_header header = {};
+    uint8_t *payload = NULL;
+    uint32_t offset = 0, total = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        request.method = 1;
+        request.arg0 = channel;
+        request.arg1 = offset;
+        if (!bridge_network_messages_rpc( &request, &response ) ||
+            !response.result) {
+            free( payload );
+            return NULL;
+        }
+        if (response.data_size < header_size) {
+            free( payload );
+            return NULL;
+        }
+        if (!offset) {
+            total = response.arg0;
+            if (total > 16u * 1024u * 1024u) return NULL;
+            memcpy( &header, response.data, header_size );
+            payload = total ? (uint8_t *)malloc( total ) : NULL;
+            if (total && !payload) return NULL;
+        }
+        uint32_t chunk = response.data_size - header_size;
+        if (chunk > total - offset) {
+            free( payload );
+            return NULL;
+        }
+        if (chunk) memcpy( payload + offset,
+                           response.data + header_size, chunk );
+        offset += chunk;
+        if (offset < total && !chunk) {
+            free( payload );
+            return NULL;
+        }
+    } while (offset < total);
+
+    u_SteamNetworkingMessage_t_153a *message =
+        (u_SteamNetworkingMessage_t_153a *)calloc( 1, sizeof(*message) );
+    if (!message) {
+        free( payload );
+        return NULL;
+    }
+    message->m_pData = payload;
+    message->m_cbSize = total;
+    message->m_conn = header.connection;
+    memcpy( &message->m_identityPeer, header.identity,
+            sizeof(message->m_identityPeer) );
+    message->m_nConnUserData = header.connection_user_data;
+    message->m_usecTimeReceived = header.time_received;
+    message->m_nMessageNumber = header.message_number;
+    message->m_pfnRelease = bridge_network_messages_release;
+    message->m_nChannel = header.channel;
+    message->m_nFlags = header.flags;
+    message->m_nUserData = header.user_data;
+    message->m_idxLane = header.lane;
+    return message;
+}
+
+static int32_t bridge_network_messages_receive(
+    void *, int32_t channel, u_SteamNetworkingMessage_t_153a **messages,
+    int32_t maximum )
+{
+    if (!messages || maximum <= 0 || maximum > 1024) return 0;
+    int32_t count = 0;
+    while (count < maximum)
+    {
+        u_SteamNetworkingMessage_t_153a *message =
+            bridge_network_messages_read_one( channel );
+        if (!message) break;
+        messages[count++] = message;
+    }
+    return count;
+}
+
+static int8_t bridge_network_messages_identity_bool(
+    uint32_t method, const SteamNetworkingIdentity_144 *identity,
+    uint32_t argument = 0 )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!identity) return 0;
+    request.method = method;
+    request.arg0 = argument;
+    request.data_size = sizeof(*identity);
+    memcpy( request.data, identity, sizeof(*identity) );
+    return bridge_network_messages_rpc( &request, &response ) &&
+           response.result;
+}
+
+static int8_t bridge_network_messages_accept(
+    void *, const SteamNetworkingIdentity_144 *identity )
+{ return bridge_network_messages_identity_bool( 2, identity ); }
+static int8_t bridge_network_messages_close(
+    void *, const SteamNetworkingIdentity_144 *identity )
+{ return bridge_network_messages_identity_bool( 3, identity ); }
+static int8_t bridge_network_messages_close_channel(
+    void *, const SteamNetworkingIdentity_144 *identity, int32_t channel )
+{ return bridge_network_messages_identity_bool( 4, identity, channel ); }
+
+static uint32_t bridge_network_messages_info(
+    void *, const SteamNetworkingIdentity_144 *identity,
+    SteamNetConnectionInfo_t_153a *info,
+    SteamNetConnectionRealTimeStatus_t_164 *quick )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!identity) return 0;
+    request.method = 5;
+    request.arg0 = (info ? 1 : 0) | (quick ? 2 : 0);
+    request.data_size = sizeof(*identity);
+    memcpy( request.data, identity, sizeof(*identity) );
+    if (!bridge_network_messages_rpc( &request, &response )) return 0;
+    uint32_t expected = (info ? sizeof(*info) : 0) +
+                        (quick ? sizeof(*quick) : 0);
+    if (response.data_size != expected) return 0;
+    uint32_t offset = 0;
+    if (info) {
+        memcpy( info, response.data, sizeof(*info) );
+        offset += sizeof(*info);
+    }
+    if (quick) memcpy( quick, response.data + offset, sizeof(*quick) );
+    return response.result;
+}
diff --git a/lsteamclient/bridge_networking_proxy.inc b/lsteamclient/bridge_networking_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..d8ccbcf6af9980e8457953d4f79e63f7de49a9b8
--- /dev/null
+++ b/lsteamclient/bridge_networking_proxy.inc
@@ -0,0 +1,126 @@
+/* Bionic-side legacy SteamNetworking006 P2P proxy. */
+static bool bridge_network_rpc( lsteam_bridge_game_server_request *request,
+                                lsteam_bridge_game_server_response *response )
+{
+    return bridge_iface_rpc( LSTEAM_BRIDGE_NETWORKING_CALL,
+                             request, response );
+}
+
+static int8_t bridge_network_send( void *, CSteamID remote, const void *data,
+                                   uint32_t size, uint32_t send_type,
+                                   int32_t channel )
+{
+    if ((size && !data) || size > 16u * 1024u * 1024u) return 0;
+    uint32_t offset = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        uint32_t chunk = size - offset;
+        if (chunk > LSTEAM_BRIDGE_MAX_TICKET)
+            chunk = LSTEAM_BRIDGE_MAX_TICKET;
+        request.method = 0;
+        request.steam_id = bridge_iface_id_value( remote );
+        request.arg0 = send_type;
+        request.arg1 = channel;
+        request.arg2 = size;
+        request.arg3 = offset;
+        request.data_size = chunk;
+        if (chunk) memcpy( request.data, (const uint8_t *)data + offset, chunk );
+        if (!bridge_network_rpc( &request, &response ) || !response.result)
+            return 0;
+        offset += chunk;
+    } while (offset < size);
+    return 1;
+}
+
+static int8_t bridge_network_available( void *, uint32_t *size, int32_t channel )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 1;
+    request.arg0 = channel;
+    if (!bridge_network_rpc( &request, &response )) return 0;
+    if (size) *size = response.arg0;
+    return response.result != 0;
+}
+
+static int8_t bridge_network_read( void *, void *data, uint32_t capacity,
+                                   uint32_t *size, CSteamID *remote,
+                                   int32_t channel )
+{
+    if (size) *size = 0;
+    if (!data || !capacity || capacity > 16u * 1024u * 1024u) return 0;
+    uint32_t offset = 0, total = 0;
+    uint64_t sender = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        request.method = 2;
+        request.arg0 = capacity;
+        request.arg1 = channel;
+        request.arg2 = offset;
+        if (!bridge_network_rpc( &request, &response )) return 0;
+        if (!offset)
+        {
+            total = response.arg0;
+            sender = response.steam_id;
+            if (!response.result)
+            {
+                if (size) *size = total;
+                return 0;
+            }
+        }
+        if (total > capacity || response.data_size > total - offset) return 0;
+        if (response.data_size)
+            memcpy( (uint8_t *)data + offset, response.data,
+                    response.data_size );
+        offset += response.data_size;
+        if (offset < total && !response.data_size) return 0;
+    } while (offset < total);
+    if (size) *size = total;
+    if (remote) *remote = bridge_iface_make_id( sender );
+    return 1;
+}
+
+static int8_t bridge_network_id_bool( uint32_t method, CSteamID remote,
+                                      uint32_t argument = 0 )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = method;
+    request.steam_id = bridge_iface_id_value( remote );
+    request.arg0 = argument;
+    return bridge_network_rpc( &request, &response ) && response.result;
+}
+static int8_t bridge_network_accept( void *, CSteamID remote )
+{ return bridge_network_id_bool( 3, remote ); }
+static int8_t bridge_network_close( void *, CSteamID remote )
+{ return bridge_network_id_bool( 4, remote ); }
+static int8_t bridge_network_close_channel( void *, CSteamID remote,
+                                            int32_t channel )
+{ return bridge_network_id_bool( 5, remote, channel ); }
+
+static int8_t bridge_network_session_state( void *, CSteamID remote,
+                                            P2PSessionState_t *state )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!state) return 0;
+    request.method = 6;
+    request.steam_id = bridge_iface_id_value( remote );
+    if (!bridge_network_rpc( &request, &response ) || !response.result ||
+        response.data_size != sizeof(*state)) return 0;
+    memcpy( state, response.data, sizeof(*state) );
+    return 1;
+}
+
+static int8_t bridge_network_allow_relay( void *, int8_t allowed )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 7;
+    request.arg0 = allowed != 0;
+    return bridge_network_rpc( &request, &response ) && response.result;
+}
diff --git a/lsteamclient/bridge_networking_sockets_proxy.inc b/lsteamclient/bridge_networking_sockets_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..18bef749c9a6dafea972458c3f894400d1af52b2
--- /dev/null
+++ b/lsteamclient/bridge_networking_sockets_proxy.inc
@@ -0,0 +1,495 @@
+/* Bionic-side SteamNetworkingSockets012/013 proxy. */
+static_assert( sizeof(SteamNetworkingIdentity_144) == 136,
+               "unexpected bridge identity ABI" );
+static_assert( sizeof(SteamNetworkingIPAddr) == 18,
+               "unexpected bridge IP address ABI" );
+
+static bool bridge_network_sockets_rpc(
+    lsteam_bridge_game_server_request *request,
+    lsteam_bridge_game_server_response *response )
+{
+    return bridge_iface_rpc( LSTEAM_BRIDGE_NETWORK_SOCKETS_CALL,
+                             request, response );
+}
+
+static int8_t bridge_network_sockets_pair(
+    void *, uint32_t *first, uint32_t *second, int8_t network_loopback,
+    const SteamNetworkingIdentity_144 *identity1,
+    const SteamNetworkingIdentity_144 *identity2 )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!first || !second) return 0;
+    request.method = 0;
+    request.arg0 = network_loopback != 0;
+    request.arg1 = (identity1 ? 1 : 0) | (identity2 ? 2 : 0);
+    if (identity1) {
+        memcpy( request.data + request.data_size, identity1,
+                sizeof(*identity1) );
+        request.data_size += sizeof(*identity1);
+    }
+    if (identity2) {
+        memcpy( request.data + request.data_size, identity2,
+                sizeof(*identity2) );
+        request.data_size += sizeof(*identity2);
+    }
+    if (!bridge_network_sockets_rpc( &request, &response ) ||
+        !response.result) return 0;
+    *first = response.arg0;
+    *second = response.arg1;
+    return 1;
+}
+
+static uint32_t bridge_network_sockets_send(
+    void *, uint32_t connection, const void *data, uint32_t size,
+    int32_t flags, int64_t *message_number )
+{
+    if ((size && !data) || size > 16u * 1024u * 1024u)
+        return 8; /* k_EResultInvalidParam */
+    uint32_t offset = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        uint32_t chunk = size - offset;
+        if (chunk > sizeof(request.data)) chunk = sizeof(request.data);
+        request.method = 1;
+        request.arg0 = connection;
+        request.arg1 = flags;
+        request.arg2 = size;
+        request.arg3 = offset;
+        request.data_size = chunk;
+        if (chunk)
+            memcpy( request.data, (const uint8_t *)data + offset, chunk );
+        if (!bridge_network_sockets_rpc( &request, &response )) return 2;
+        offset += chunk;
+        if (offset == size) {
+            if (message_number)
+                *message_number = (int64_t)response.steam_id;
+            return response.result;
+        }
+    } while (offset < size);
+    return 2;
+}
+
+static void U_CDECL bridge_network_sockets_release(
+    u_SteamNetworkingMessage_t_153a *message )
+{
+    if (!message) return;
+    free( message->m_pData );
+    free( message );
+}
+
+static u_SteamNetworkingMessage_t_153a *bridge_network_sockets_read_one(
+    uint32_t handle, bool poll_group )
+{
+    const uint32_t header_size = sizeof(lsteam_bridge_network_message_header);
+    lsteam_bridge_network_message_header header = {};
+    uint8_t *payload = NULL;
+    uint32_t offset = 0, total = 0;
+    do
+    {
+        lsteam_bridge_game_server_request request = {};
+        lsteam_bridge_game_server_response response = {};
+        request.method = poll_group ? 20 : 2;
+        request.arg0 = handle;
+        request.arg1 = offset;
+        if (!bridge_network_sockets_rpc( &request, &response ) ||
+            !response.result) {
+            free( payload );
+            return NULL;
+        }
+        if (response.data_size < header_size) {
+            free( payload );
+            return NULL;
+        }
+        if (!offset) {
+            total = response.arg0;
+            if (total > 16u * 1024u * 1024u) return NULL;
+            memcpy( &header, response.data, header_size );
+            payload = total ? (uint8_t *)malloc( total ) : NULL;
+            if (total && !payload) return NULL;
+        }
+        uint32_t chunk = response.data_size - header_size;
+        if (chunk > total - offset) {
+            free( payload );
+            return NULL;
+        }
+        if (chunk) memcpy( payload + offset,
+                           response.data + header_size, chunk );
+        offset += chunk;
+        if (offset < total && !chunk) {
+            free( payload );
+            return NULL;
+        }
+    } while (offset < total);
+
+    u_SteamNetworkingMessage_t_153a *message =
+        (u_SteamNetworkingMessage_t_153a *)calloc( 1, sizeof(*message) );
+    if (!message) {
+        free( payload );
+        return NULL;
+    }
+    message->m_pData = payload;
+    message->m_cbSize = total;
+    message->m_conn = header.connection;
+    memcpy( &message->m_identityPeer, header.identity,
+            sizeof(message->m_identityPeer) );
+    message->m_nConnUserData = header.connection_user_data;
+    message->m_usecTimeReceived = header.time_received;
+    message->m_nMessageNumber = header.message_number;
+    message->m_pfnRelease = bridge_network_sockets_release;
+    message->m_nChannel = header.channel;
+    message->m_nFlags = header.flags;
+    message->m_nUserData = header.user_data;
+    message->m_idxLane = header.lane;
+    return message;
+}
+
+static int32_t bridge_network_sockets_receive_common(
+    uint32_t handle, u_SteamNetworkingMessage_t_153a **messages,
+    int32_t maximum, bool poll_group )
+{
+    if (!messages || maximum <= 0 || maximum > 1024) return 0;
+    int32_t count = 0;
+    while (count < maximum) {
+        u_SteamNetworkingMessage_t_153a *message =
+            bridge_network_sockets_read_one( handle, poll_group );
+        if (!message) break;
+        messages[count++] = message;
+    }
+    return count;
+}
+
+static int32_t bridge_network_sockets_receive(
+    void *, uint32_t connection, u_SteamNetworkingMessage_t_153a **messages,
+    int32_t maximum )
+{
+    return bridge_network_sockets_receive_common(
+        connection, messages, maximum, false );
+}
+
+static int32_t bridge_network_sockets_receive_poll(
+    void *, uint32_t group, u_SteamNetworkingMessage_t_153a **messages,
+    int32_t maximum )
+{
+    return bridge_network_sockets_receive_common(
+        group, messages, maximum, true );
+}
+
+static uint32_t bridge_network_sockets_handle_result(
+    uint32_t method, uint32_t handle )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = method;
+    request.arg0 = handle;
+    return bridge_network_sockets_rpc( &request, &response )
+        ? response.result : 2;
+}
+
+static uint32_t bridge_network_sockets_accept(void *, uint32_t connection)
+{ return bridge_network_sockets_handle_result( 3, connection ); }
+static int8_t bridge_network_sockets_close_listen(void *, uint32_t socket)
+{ return bridge_network_sockets_handle_result( 5, socket ) != 0; }
+static uint32_t bridge_network_sockets_flush(void *, uint32_t connection)
+{ return bridge_network_sockets_handle_result( 10, connection ); }
+static uint32_t bridge_network_sockets_create_poll(void *)
+{ return bridge_network_sockets_handle_result( 17, 0 ); }
+static int8_t bridge_network_sockets_destroy_poll(void *, uint32_t group)
+{ return bridge_network_sockets_handle_result( 18, group ) != 0; }
+
+static int8_t bridge_network_sockets_close(
+    void *, uint32_t connection, int32_t reason, const char *debug,
+    int8_t linger )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 4;
+    request.arg0 = connection;
+    request.arg1 = reason;
+    request.arg2 = linger != 0;
+    if (debug) snprintf( request.text, sizeof(request.text), "%s", debug );
+    return bridge_network_sockets_rpc( &request, &response ) &&
+           response.result;
+}
+
+static int8_t bridge_network_sockets_set_userdata(
+    void *, uint32_t connection, int64_t user_data )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 6;
+    request.arg0 = connection;
+    request.steam_id = (uint64_t)user_data;
+    return bridge_network_sockets_rpc( &request, &response ) &&
+           response.result;
+}
+
+static int64_t bridge_network_sockets_get_userdata(
+    void *, uint32_t connection )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 7;
+    request.arg0 = connection;
+    return bridge_network_sockets_rpc( &request, &response )
+        ? (int64_t)response.steam_id : -1;
+}
+
+static void bridge_network_sockets_set_name(
+    void *, uint32_t connection, const char *name )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 8;
+    request.arg0 = connection;
+    if (name) snprintf( request.text, sizeof(request.text), "%s", name );
+    bridge_network_sockets_rpc( &request, &response );
+}
+
+static int8_t bridge_network_sockets_get_name(
+    void *, uint32_t connection, char *name, int32_t capacity )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!name || capacity <= 0) return 0;
+    request.method = 9;
+    request.arg0 = connection;
+    request.arg1 = capacity;
+    if (!bridge_network_sockets_rpc( &request, &response ) ||
+        !response.result || !response.data_size) return 0;
+    uint32_t copy = response.data_size;
+    if (copy >= (uint32_t)capacity) copy = capacity - 1;
+    memcpy( name, response.data, copy );
+    name[copy] = 0;
+    return 1;
+}
+
+static int8_t bridge_network_sockets_info(
+    void *, uint32_t connection, SteamNetConnectionInfo_t_153a *info )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!info) return 0;
+    request.method = 11;
+    request.arg0 = connection;
+    if (!bridge_network_sockets_rpc( &request, &response ) ||
+        !response.result || response.data_size != sizeof(*info)) return 0;
+    memcpy( info, response.data, sizeof(*info) );
+    return 1;
+}
+
+static uint32_t bridge_network_sockets_quick(
+    void *, uint32_t connection, SteamNetConnectionRealTimeStatus_t_164 *quick,
+    int32_t lane_count, SteamNetConnectionRealTimeLaneStatus_t *lanes )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (lane_count < 0 || lane_count > 16 || (lane_count && !lanes)) return 8;
+    request.method = 12;
+    request.arg0 = connection;
+    request.arg1 = lane_count;
+    request.arg2 = quick ? 1 : 0;
+    if (!bridge_network_sockets_rpc( &request, &response )) return 2;
+    size_t expected = (quick ? sizeof(*quick) : 0) +
+                      lane_count * sizeof(*lanes);
+    if (response.data_size != expected) return 2;
+    size_t offset = 0;
+    if (quick) {
+        memcpy( quick, response.data, sizeof(*quick) );
+        offset += sizeof(*quick);
+    }
+    if (lane_count)
+        memcpy( lanes, response.data + offset, lane_count * sizeof(*lanes) );
+    return response.result;
+}
+
+static int32_t bridge_network_sockets_detailed(
+    void *, uint32_t connection, char *buffer, int32_t capacity )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (capacity < 0 || (capacity && !buffer)) return -1;
+    request.method = 13;
+    request.arg0 = connection;
+    request.arg1 = capacity;
+    if (!bridge_network_sockets_rpc( &request, &response )) return -1;
+    if (capacity && response.data_size) {
+        uint32_t copy = response.data_size;
+        if (copy >= (uint32_t)capacity) copy = capacity - 1;
+        memcpy( buffer, response.data, copy );
+        buffer[copy] = 0;
+    }
+    return (int32_t)(int64_t)response.result;
+}
+
+static int8_t bridge_network_sockets_identity(
+    void *, SteamNetworkingIdentity_144 *identity )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!identity) return 0;
+    request.method = 14;
+    if (!bridge_network_sockets_rpc( &request, &response ) ||
+        !response.result || response.data_size != sizeof(*identity)) return 0;
+    memcpy( identity, response.data, sizeof(*identity) );
+    return 1;
+}
+
+static uint32_t bridge_network_sockets_init_auth(void *)
+{ return bridge_network_sockets_handle_result( 15, 0 ); }
+
+static uint32_t bridge_network_sockets_auth_status(
+    void *, SteamNetAuthenticationStatus_t *details )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 16;
+    request.arg0 = details != NULL;
+    if (!bridge_network_sockets_rpc( &request, &response )) return 0;
+    if (details) {
+        if (response.data_size != sizeof(*details)) return 0;
+        memcpy( details, response.data, sizeof(*details) );
+    }
+    return response.result;
+}
+
+static int8_t bridge_network_sockets_set_poll(
+    void *, uint32_t connection, uint32_t group )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 19;
+    request.arg0 = connection;
+    request.arg1 = group;
+    return bridge_network_sockets_rpc( &request, &response ) &&
+           response.result;
+}
+
+static uint32_t bridge_network_sockets_listen_p2p(
+    void *, int32_t port, int32_t option_count,
+    const SteamNetworkingConfigValue_t * )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (option_count) return 0;
+    request.method = 21;
+    request.arg0 = port;
+    return bridge_network_sockets_rpc( &request, &response )
+        ? response.result : 0;
+}
+
+static uint32_t bridge_network_sockets_connect_p2p(
+    void *, const SteamNetworkingIdentity_144 *identity, int32_t port,
+    int32_t option_count, const SteamNetworkingConfigValue_t * )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!identity || option_count) return 0;
+    request.method = 22;
+    request.arg0 = port;
+    request.data_size = sizeof(*identity);
+    memcpy( request.data, identity, sizeof(*identity) );
+    return bridge_network_sockets_rpc( &request, &response )
+        ? response.result : 0;
+}
+
+static uint32_t bridge_network_sockets_ip_common(
+    uint32_t method, const SteamNetworkingIPAddr *address,
+    int32_t option_count )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!address || option_count) return 0;
+    request.method = method;
+    request.data_size = sizeof(*address);
+    memcpy( request.data, address, sizeof(*address) );
+    return bridge_network_sockets_rpc( &request, &response )
+        ? response.result : 0;
+}
+
+static uint32_t bridge_network_sockets_listen_ip(
+    void *, const SteamNetworkingIPAddr *address, int32_t option_count,
+    const SteamNetworkingConfigValue_t * )
+{ return bridge_network_sockets_ip_common( 23, address, option_count ); }
+
+static uint32_t bridge_network_sockets_connect_ip(
+    void *, const SteamNetworkingIPAddr *address, int32_t option_count,
+    const SteamNetworkingConfigValue_t * )
+{ return bridge_network_sockets_ip_common( 24, address, option_count ); }
+
+static int8_t bridge_network_sockets_listen_address(
+    void *, uint32_t socket, SteamNetworkingIPAddr *address )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!address) return 0;
+    request.method = 25;
+    request.arg0 = socket;
+    if (!bridge_network_sockets_rpc( &request, &response ) ||
+        !response.result || response.data_size != sizeof(*address)) return 0;
+    memcpy( address, response.data, sizeof(*address) );
+    return 1;
+}
+
+static uint32_t bridge_network_sockets_lanes(
+    void *, uint32_t connection, int32_t count, const int32_t *priorities,
+    const uint16_t *weights )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (count < 0 || count > 128 ||
+        (count && (!priorities || !weights))) return 8;
+    request.method = 26;
+    request.arg0 = connection;
+    request.arg1 = count;
+    request.data_size = count * (sizeof(*priorities) + sizeof(*weights));
+    if (count) {
+        memcpy( request.data, priorities, count * sizeof(*priorities) );
+        memcpy( request.data + count * sizeof(*priorities), weights,
+                count * sizeof(*weights) );
+    }
+    return bridge_network_sockets_rpc( &request, &response )
+        ? response.result : 2;
+}
+
+static void bridge_network_sockets_send_many_common(
+    void *iface, int32_t count, u_SteamNetworkingMessage_t_153a **messages,
+    int64_t *results, bool delete_failed )
+{
+    if (count < 0 || count > 1024 || (count && !messages)) return;
+    for (int32_t index = 0; index < count; ++index) {
+        u_SteamNetworkingMessage_t_153a *message = messages[index];
+        uint32_t result = message
+            ? bridge_network_sockets_send(
+                iface, message->m_conn, message->m_pData, message->m_cbSize,
+                message->m_nFlags, results ? &results[index] : NULL)
+            : 8;
+        if (results && result != 1) results[index] = -(int64_t)result;
+        if (message && (result == 1 || delete_failed) && message->m_pfnRelease) {
+            message->m_pfnRelease( message );
+        }
+    }
+}
+
+/* SteamNetworkingSockets012 owns every message accepted by SendMessages and
+ * has no bDeleteFailed argument.  013 added that argument, so sharing a raw
+ * vtable entry would read a garbage fifth register for 012 callers. */
+static void bridge_network_sockets_send_many12(
+    void *iface, int32_t count,
+    u_SteamNetworkingMessage_t_153a *const *messages, int64_t *results )
+{
+    bridge_network_sockets_send_many_common(
+        iface, count,
+        const_cast<u_SteamNetworkingMessage_t_153a **>( messages ),
+        results, true );
+}
+
+static void bridge_network_sockets_send_many13(
+    void *iface, int32_t count, u_SteamNetworkingMessage_t_153a **messages,
+    int64_t *results, int8_t delete_failed )
+{
+    bridge_network_sockets_send_many_common(
+        iface, count, messages, results, delete_failed != 0 );
+}
