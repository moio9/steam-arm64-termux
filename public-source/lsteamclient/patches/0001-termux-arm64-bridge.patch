diff --git a/lsteamclient/bridge_client_proxy.inc b/lsteamclient/bridge_client_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..4ffb29f2638af72788143413385e328a1f254caa
--- /dev/null
+++ b/lsteamclient/bridge_client_proxy.inc
@@ -0,0 +1,35 @@
+/* Bionic-side ISteamClient calls which cannot be represented by the shared
+ * local handle/getter helpers. */
+static void bridge_client_set_local_ipv4( void *, uint32_t ip, uint16_t port )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 0;
+    request.arg0 = port;
+    request.data_size = sizeof(ip);
+    memcpy( request.data, &ip, sizeof(ip) );
+    bridge_iface_rpc( LSTEAM_BRIDGE_CLIENT_CALL, &request, &response );
+}
+
+static void bridge_client_set_local_ip( void *,
+                                        const SteamIPAddress_t *address,
+                                        uint16_t port )
+{
+    if (!address) return;
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 0;
+    request.arg0 = port;
+    request.data_size = sizeof(*address);
+    memcpy( request.data, address, sizeof(*address) );
+    bridge_iface_rpc( LSTEAM_BRIDGE_CLIENT_CALL, &request, &response );
+}
+
+static void bridge_client_set_callback_checker(
+    void *, uint32_t (U_CDECL *callback)(int32_t) )
+{
+    /* A Wine callback pointer cannot cross into Steam's native process.  The
+     * server installs an always-registered checker and forwards the resulting
+     * callback queue back to Wine, so retaining this pointer is unnecessary. */
+    (void)callback;
+}
diff --git a/lsteamclient/bridge_gamesearch_proxy.inc b/lsteamclient/bridge_gamesearch_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..a8ce4290db765a1a509d0591e31b31d9b6e58330
--- /dev/null
+++ b/lsteamclient/bridge_gamesearch_proxy.inc
@@ -0,0 +1,127 @@
+/* Bionic-side SteamMatchGameSearch001 proxy. */
+static bool bridge_game_search_rpc(
+    lsteam_bridge_game_server_request *request,
+    lsteam_bridge_game_server_response *response )
+{
+    return bridge_iface_rpc( LSTEAM_BRIDGE_GAME_SEARCH_CALL,
+                             request, response );
+}
+
+static uint32_t bridge_game_search_result(
+    uint32_t method, uint64_t steam_id = 0, uint32_t arg0 = 0,
+    uint32_t arg1 = 0, uint32_t arg2 = 0 )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = method;
+    request.steam_id = steam_id;
+    request.arg0 = arg0;
+    request.arg1 = arg1;
+    request.arg2 = arg2;
+    return bridge_game_search_rpc( &request, &response )
+        ? response.result : 9 /* k_EGameSearchErrorCode_Failed_Unknown_Error */;
+}
+
+static uint32_t bridge_game_search_text_pair(
+    uint32_t method, const char *key, const char *value )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!key || !value || strlen(key) >= sizeof(request.text) ||
+        strlen(value) >= sizeof(request.value)) return 6;
+    request.method = method;
+    bridge_iface_copy_text( request.text, key );
+    bridge_iface_copy_text( request.value, value );
+    return bridge_game_search_rpc( &request, &response )
+        ? response.result : 9;
+}
+
+static uint32_t bridge_game_search_add( void *, const char *key,
+                                        const char *values )
+{ return bridge_game_search_text_pair( 0, key, values ); }
+
+static uint32_t bridge_game_search_lobby( void *, CSteamID lobby,
+                                          int32_t minimum, int32_t maximum )
+{
+    return bridge_game_search_result( 1, bridge_iface_id_value( lobby ),
+                                      minimum, maximum );
+}
+
+static uint32_t bridge_game_search_solo( void *, int32_t minimum,
+                                         int32_t maximum )
+{ return bridge_game_search_result( 2, 0, minimum, maximum ); }
+
+static uint32_t bridge_game_search_accept( void * )
+{ return bridge_game_search_result( 3 ); }
+static uint32_t bridge_game_search_decline( void * )
+{ return bridge_game_search_result( 4 ); }
+
+static uint32_t bridge_game_search_connection(
+    void *, CSteamID host, char *details, int32_t capacity )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (!details || capacity <= 0 ||
+        (uint32_t)capacity > sizeof(response.data)) return 6;
+    request.method = 5;
+    request.steam_id = bridge_iface_id_value( host );
+    request.arg0 = capacity;
+    if (!bridge_game_search_rpc( &request, &response )) return 9;
+    if (response.data_size > (uint32_t)capacity) return 9;
+    if (response.data_size)
+        memcpy( details, response.data, response.data_size );
+    if (!response.data_size || response.data_size == (uint32_t)capacity)
+        details[capacity - 1] = 0;
+    return response.result;
+}
+
+static uint32_t bridge_game_search_end_search( void * )
+{ return bridge_game_search_result( 6 ); }
+
+static uint32_t bridge_game_search_host_params( void *, const char *key,
+                                                const char *value )
+{ return bridge_game_search_text_pair( 7, key, value ); }
+
+static uint32_t bridge_game_search_set_connection(
+    void *, const char *details, int32_t size )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    if (size < 0 || (size && !details) ||
+        (uint32_t)size > sizeof(request.data)) return 6;
+    request.method = 8;
+    request.data_size = size;
+    if (size) memcpy( request.data, details, size );
+    return bridge_game_search_rpc( &request, &response )
+        ? response.result : 9;
+}
+
+static uint32_t bridge_game_search_request_players(
+    void *, int32_t minimum, int32_t maximum, int32_t team_maximum )
+{
+    return bridge_game_search_result( 9, 0, minimum, maximum, team_maximum );
+}
+
+static uint32_t bridge_game_search_confirm( void *, uint64_t game_id )
+{ return bridge_game_search_result( 10, game_id ); }
+
+static uint32_t bridge_game_search_cancel( void * )
+{ return bridge_game_search_result( 11 ); }
+
+static uint32_t bridge_game_search_submit(
+    void *, uint64_t game_id, CSteamID player, uint32_t player_result )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    uint64_t player_id = bridge_iface_id_value( player );
+    request.method = 12;
+    request.steam_id = game_id;
+    request.arg0 = player_result;
+    request.data_size = sizeof(player_id);
+    memcpy( request.data, &player_id, sizeof(player_id) );
+    return bridge_game_search_rpc( &request, &response )
+        ? response.result : 9;
+}
+
+static uint32_t bridge_game_search_end_game( void *, uint64_t game_id )
+{ return bridge_game_search_result( 13, game_id ); }
diff --git a/lsteamclient/bridge_gameserver_proxy.inc b/lsteamclient/bridge_gameserver_proxy.inc
new file mode 100644
index 0000000000000000000000000000000000000000..5022b958680fb3f196b7c3d91ea93e0f59c85837
--- /dev/null
+++ b/lsteamclient/bridge_gameserver_proxy.inc
@@ -0,0 +1,325 @@
+/* Bionic-side ISteamGameServer013 proxy. Keep signatures in vtable order. */
+static uint64_t bridge_gs_id_value( CSteamID id )
+{
+    uint64_t value = 0;
+    memcpy( &value, &id, sizeof(value) );
+    return value;
+}
+
+static CSteamID bridge_gs_make_id( uint64_t value )
+{
+    CSteamID id = {};
+    memcpy( &id, &value, sizeof(value) );
+    return id;
+}
+
+static void bridge_gs_copy_text( char *dst, const char *src )
+{
+    snprintf( dst, LSTEAM_BRIDGE_MAX_TEXT, "%s", src ? src : "" );
+}
+
+static bool bridge_gs_rpc( lsteam_bridge_game_server_request *game,
+                           lsteam_bridge_game_server_response *response )
+{
+    const char *path = getenv( "LSTEAM_BRIDGE_SOCKET" );
+    if (!path || !*path) path = LSTEAM_BRIDGE_DEFAULT_SOCKET;
+    if (strlen(path) >= sizeof(((sockaddr_un *)0)->sun_path)) return false;
+
+    int fd = socket( AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0 );
+    if (fd < 0) return false;
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    memcpy( address.sun_path, path, strlen(path) + 1 );
+    if (connect( fd, (sockaddr *)&address,
+                 offsetof(sockaddr_un, sun_path) + strlen(path) + 1 ) < 0)
+    {
+        close( fd );
+        return false;
+    }
+
+    static uint32_t next_sequence = 100;
+    lsteam_bridge_request request = { LSTEAM_BRIDGE_MAGIC, LSTEAM_BRIDGE_VERSION,
+        LSTEAM_BRIDGE_GAME_SERVER_CALL,
+        __atomic_add_fetch( &next_sequence, 1, __ATOMIC_RELAXED ) };
+    memset( response, 0, sizeof(*response) );
+    bool ok = send( fd, &request, sizeof(request), MSG_NOSIGNAL ) == sizeof(request) &&
+              send( fd, game, sizeof(*game), MSG_NOSIGNAL ) == sizeof(*game) &&
+              recv( fd, response, sizeof(*response), 0 ) == sizeof(*response);
+    close( fd );
+    ok = ok && response->magic == LSTEAM_BRIDGE_MAGIC &&
+         response->version == LSTEAM_BRIDGE_VERSION &&
+         response->opcode == LSTEAM_BRIDGE_GAME_SERVER_CALL &&
+         response->sequence == request.sequence && !response->status;
+    if (!ok) bridge_trace( "GameServer method=%u failed status=%d", game->method,
+                           response->status );
+    return ok;
+}
+
+static uint64_t bridge_gs_result( uint32_t method )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = method;
+    return bridge_gs_rpc( &request, &response ) ? response.result : 0;
+}
+
+static int8_t bridge_gs_init( void *, uint32_t ip, uint16_t game_port,
+                              uint16_t query_port, uint32_t flags, uint32_t appid,
+                              const char *version )
+{
+    lsteam_bridge_game_server_request request = {};
+    lsteam_bridge_game_server_response response = {};
+    request.method = 0;
+    request.arg0 = ip;
+    request.arg1 = game_port;
+    request.arg2 = query_port;
+    request.arg3 = flags;
+    request.steam_id = appid;
+    bridge_gs_copy_text( request.text, version );
+    int8_t ok = bridge_gs_rpc( &request, &response ) && response.result;
+    bridge_trace( "GameServer Init appid=%u ports=%u/%u ok=%d", appid,
+                  game_port, query_port, ok );
+    return ok;
+}
