#!/data/data/com.termux/files/usr/glibc/bin/bash
set -euo pipefail

verb=${1:-}
if [[ -z $verb ]]; then
    printf '%s\n' 'proton-bionic-termux: missing compatibility-tool verb' >&2
    exit 2
fi
shift

compat_data=${STEAM_COMPAT_DATA_PATH:-}
if [[ -z $compat_data || $compat_data != /* ]]; then
    printf '%s\n' 'proton-bionic-termux: STEAM_COMPAT_DATA_PATH is missing' >&2
    exit 2
fi

# Steam probes every registered tool with this helper under compatdata/0.
# Running Wine for the probe creates a multi-gigabyte throwaway prefix, while
# the native Steam client already performs its own graphics detection.
case ${1:-} in
    */d3ddriverquery.exe|*/d3ddriverquery64.exe)
        if [[ ${SteamAppId:-${SteamGameId:-0}} == 0 ]]; then
            exit 1
        fi
        ;;
esac

tool_dir=${BASH_SOURCE[0]%/*}
tool_dir=$(cd -- "$tool_dir" && pwd -P)
export PATH="$tool_dir:$PATH"
root=$(cd -- "$tool_dir/.." && pwd -P)
appid=${SteamAppId:-${SteamGameId:-0}}
default_prefix=$root/prefixes/bionic
prefix=$default_prefix
if [[ -n ${PROTON_BIONIC_PREFIX:-} ]]; then
    prefix=$PROTON_BIONIC_PREFIX
elif [[ $appid =~ ^[0-9]+$ && -f $root/config/games/$appid/prefix-path ]]; then
    configured_prefix=$(<"$root/config/games/$appid/prefix-path")
    if [[ $configured_prefix == /* && $configured_prefix != / &&
          $configured_prefix != "${HOME:?HOME is required}" &&
          $configured_prefix != *$'\n'* ]]; then
        prefix=$configured_prefix
    else
        printf 'proton-bionic-termux: ignoring unsafe prefix configured for AppID %s: %s\n' \
            "$appid" "$configured_prefix" >&2
    fi
fi
log=${PROTON_BIONIC_LOG:-$compat_data/proton-bionic-termux.log}
wine=${PROTON_BIONIC_WINE:-/data/data/com.termux/files/home/bin/hangover-wine}
wineserver=${PROTON_BIONIC_WINESERVER:-/data/data/com.termux/files/usr/opt/hangover-wine/bin/wineserver}
fex_payload=${PROTON_BIONIC_FEX_PAYLOAD:-}
dxvk=$tool_dir/vendor/dxvk-1.10.3
vkd3d=$tool_dir/vendor/vkd3d-proton-3.0.1
component_version=dxvk-1.10.3_vkd3d-proton-3.0.1
component_flavor=${PROTON_BIONIC_COMPONENT_FLAVOR:-hangover}
cpu_backend=${PROTON_BIONIC_CPU_BACKEND:-box64}
component_marker=$prefix/.proton-bionic-$component_flavor-$component_version
legacycompat=$root/legacycompat
if [[ ! -d $legacycompat && -d $root/valve-client/legacycompat ]]; then
    legacycompat=$root/valve-client/legacycompat
fi
legacy_steamclient64=$legacycompat/steamclient64.dll
if [[ ! -f $legacy_steamclient64 && -f $root/valve-client/steamclient64.dll ]]; then
    legacy_steamclient64=$root/valve-client/steamclient64.dll
elif [[ ! -f $legacy_steamclient64 && -f $root/steamclient64.dll ]]; then
    legacy_steamclient64=$root/steamclient64.dll
fi
wine_root=/data/data/com.termux/files/usr/opt/hangover-wine
lsteamclient_pe=$wine_root/lib/wine/i386-windows/lsteamclient.dll
steam_stub=$wine_root/lib/wine/i386-windows/steam.exe
steam_stub_native=${PROTON_BIONIC_STEAM_STUB_NATIVE:-}
steam_helper='C:\windows\syswow64\steam.exe'
if [[ -n $steam_stub_native ]]; then
    steam_helper='C:\windows\system32\steam.exe'
fi
# Use the authenticated native Steam session by default. Set this to legacy
# only as a compatibility fallback for a title that does not need Steamworks.
steam_bridge=${PROTON_BIONIC_STEAM_BRIDGE:-proxy}
virtual_steam="$prefix/drive_c/Program Files (x86)/Steam"
steam_library_mapped=0
bridge_root=$root/steam-bridge
bridge_socket=${LSTEAM_BRIDGE_SOCKET:-/data/data/com.termux/files/usr/tmp/lsteambridge.sock}
bridge_trace=${LSTEAM_BRIDGE_TRACE:-$compat_data/lsteambridge-trace.log}

install -d -m 0700 -- "$compat_data" "$prefix"
printf '%s verb=%s appid=%s target=%q\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$verb" \
    "${SteamAppId:-${SteamGameId:-unknown}}" "${1:-}" >> "$log"

# Steam is glibc while this Wine/FEX stack is native Android Bionic.
unset LD_PRELOAD LD_LIBRARY_PATH GLIBC_LD_LIBRARY_PATH
unset TGCOMPAT_LD_SO TGCOMPAT_LIBRARY_PATH TGCOMPAT_EXEC_LD_PRELOAD
unset TGCOMPAT_EXEC_SHELL TGCOMPAT_EXEC_PATH_FROM TGCOMPAT_EXEC_PATH_TO
unset VK_LOADER_DRIVERS_SELECT VK_LOADER_DRIVERS_DISABLE
export LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib
export VK_DRIVER_FILES=/data/data/com.termux/files/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
export VK_ICD_FILENAMES=$VK_DRIVER_FILES
export WINEPREFIX=$prefix
export TERMUX_GAMEPAD_BACKEND=sdl
export WINEESYNC=${WINEESYNC:-1}
export WINEDEBUG=${PROTON_BIONIC_WINEDEBUG:--all}
export WINEDLLOVERRIDES='steam.exe=b;dxgi,d3d8,d3d9,d3d10core,d3d11,d3d12,d3d12core=n,b'
export DXVK_FILTER_DEVICE_NAME=${DXVK_FILTER_DEVICE_NAME:-Turnip}
export VKD3D_FILTER_DEVICE_NAME=${VKD3D_FILTER_DEVICE_NAME:-Turnip}
. "$bridge_root/proton-functions.sh"

[[ -x $wine ]] || {
    printf 'proton-bionic-termux: Wine launcher is unavailable: %s\n' "$wine" >&2
    exit 127
}

# Steam's compatibility-tool API passes the install directory separately.
# Wine does not switch to it for us, while many games (notably Source) resolve
# assets such as gameinfo.txt and VPKs relative to their working directory.
launch_workdir=${STEAM_COMPAT_INSTALL_PATH:-}
if [[ -z $launch_workdir || ! -d $launch_workdir ]]; then
    case ${1:-} in
        /*/*) launch_workdir=${1%/*} ;;
        *) launch_workdir=$PWD ;;
    esac
fi
launch_cwd=$launch_workdir
# Steam generates evaluator scripts below the client's legacycompat directory
# but passes their path relative to the client root. Keep the game's install
# directory for %INSTALLDIR% and prefix setup, while giving the evaluator the
# working directory its relative script argument requires.
case ${1:-} in
    */iscriptevaluator.exe)
        launch_cwd=${legacycompat%/legacycompat}
        ;;
esac

prepare_launch_args() {
    launch_args=("$@")
    local i arg relative_game windows_game steamapps_dir workshop_dir appid
    local game_dir_name windows_game_root relative_path
    local -a filtered_args=()
    if [[ $steam_bridge == legacy ]]; then
        for arg in "${launch_args[@]}"; do
            [[ $arg == -steam ]] || filtered_args+=("$arg")
        done
        launch_args=("${filtered_args[@]}")
    fi
    install -d -m 0700 -- "$prefix/dosdevices"
    ln -sfn -- "$launch_workdir" "$prefix/dosdevices/g:"
    steamapps_dir=${launch_workdir%/common/*}
    if [[ $steamapps_dir != "$launch_workdir" ]]; then
        appid=${SteamAppId:-${SteamGameId:-0}}
        workshop_dir=$steamapps_dir/workshop/content/$appid
        ln -sfn -- "$workshop_dir" "$prefix/dosdevices/w:"
    fi
    # Older Steam DRM wrappers reject games that appear to be installed on a
    # different Windows drive than Steam (Application Load Error 5).  Once the
    # real library is exposed below the registered C: Steam path, pass the game
    # executable through that same path instead of Wine's G:/Z: Unix mapping.
    if [[ $steam_library_mapped == 1 ]]; then
        game_dir_name=${launch_workdir##*/}
        windows_game_root="C:\\Program Files (x86)\\Steam\\steamapps\\common\\$game_dir_name"
        for ((i = 0; i < ${#launch_args[@]}; i++)); do
            arg=${launch_args[i]}
            if [[ $arg == "$launch_workdir" ]]; then
                launch_args[i]=$windows_game_root
            elif [[ $arg == "$launch_workdir/"* ]]; then
                relative_path=${arg#"$launch_workdir/"}
                launch_args[i]="$windows_game_root\\${relative_path//\//\\}"
            fi
        done
    fi
    for ((i = 0; i + 1 < ${#launch_args[@]}; i++)); do
        [[ ${launch_args[i]} == -game ]] || continue
        relative_game=${launch_args[i + 1]}
        [[ $relative_game != /* && $relative_game != [A-Za-z]:\\* ]] || continue
        [[ -d $launch_workdir/$relative_game ]] || continue
        if [[ $steam_library_mapped == 1 ]]; then
            windows_game="$windows_game_root\\$relative_game"
        else
            windows_game="G:\\$relative_game"
        fi
        launch_args[i + 1]=$windows_game
    done
    printf '%s cwd=%q args=' "$(date '+%Y-%m-%d %H:%M:%S')" "$launch_cwd" >> "$log"
    printf ' %q' "${launch_args[@]}" >> "$log"
    printf '\n' >> "$log"
}

sync_installscript_registry_views() {
    local target=${1:-} script_arg=${2:-} script_path line pending_key key value
    local block_name pair query32 query64 data32 data64 mirrored=0 created=0 i
    local -a vdf_stack=() registry_keys=() registry_values=()
    local -A seen=()

    case $target in
        */iscriptevaluator.exe) ;;
        *) return 0 ;;
    esac
    [[ -n $script_arg ]] || return 0
    script_path=${script_arg//\\//}
    if [[ $script_path != /* ]]; then
        script_path=$launch_cwd/$script_path
    fi
    [[ $script_path == "$launch_cwd/"* && -f $script_path && ! -L $script_path ]] || {
        printf 'proton-bionic-termux: cannot safely inspect evaluator script: %s\n' \
            "$script_path" >&2
        return 0
    }

    # InstallScript evaluators are 32-bit, while maintenance helpers may write
    # their has-run markers through the 64-bit registry view. Parse only the
    # marker pairs declared by Steam's generated evaluator VDF and mirror an
    # existing DWORD into the missing view. Hangover cannot reliably complete
    # several redistributable installers (notably DXSETUP), so create a marker
    # in both views when Steam has not recorded one yet. DXVK/vkd3d and Wine's
    # runtime DLLs are installed by this tool before the evaluator is started.
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        if [[ $line =~ ^[[:space:]]*\"([^\"]+)\"[[:space:]]+\"([^\"]*)\"[[:space:]]*$ ]]; then
            key=${BASH_REMATCH[1]}
            value=${BASH_REMATCH[2]}
            value=${value//\\\\/$'\\'}
            if [[ ${key,,} == hasrunkey && ${#vdf_stack[@]} -gt 0 ]]; then
                block_name=${vdf_stack[${#vdf_stack[@]}-1]}
                registry_keys+=("$value")
                registry_values+=("$block_name")
            fi
            pending_key=
        elif [[ $line =~ ^[[:space:]]*\"([^\"]+)\"[[:space:]]*$ ]]; then
            pending_key=${BASH_REMATCH[1]}
        elif [[ $line =~ ^[[:space:]]*\{[[:space:]]*$ ]]; then
            vdf_stack+=("${pending_key:-}")
            pending_key=
        elif [[ $line =~ ^[[:space:]]*\}[[:space:]]*$ ]]; then
            if [[ ${#vdf_stack[@]} -gt 0 ]]; then
                unset 'vdf_stack[${#vdf_stack[@]}-1]'
            fi
            pending_key=
        fi
    done < "$script_path"

    for ((i = 0; i < ${#registry_keys[@]}; i++)); do
        key=${registry_keys[i]}
        value=${registry_values[i]}
        [[ $key =~ ^(HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER)\\ && -n $value ]] || continue
        pair=$key$'\034'$value
        [[ -z ${seen[$pair]:-} ]] || continue
        seen[$pair]=1
        query32=$("$wine" reg query "$key" /v "$value" /reg:32 2>/dev/null || true)
        query64=$("$wine" reg query "$key" /v "$value" /reg:64 2>/dev/null || true)
        data32=
        data64=
        if [[ $query32 =~ REG_DWORD[[:space:]]+(0x[0-9A-Fa-f]+|[0-9]+) ]]; then
            data32=${BASH_REMATCH[1]}
        fi
        if [[ $query64 =~ REG_DWORD[[:space:]]+(0x[0-9A-Fa-f]+|[0-9]+) ]]; then
            data64=${BASH_REMATCH[1]}
        fi
        if [[ -n $data32 && -z $data64 ]]; then
            "$wine" reg add "$key" /v "$value" /t REG_DWORD /d "$data32" \
                /f /reg:64 >/dev/null
            ((mirrored += 1))
        elif [[ -n $data64 && -z $data32 ]]; then
            "$wine" reg add "$key" /v "$value" /t REG_DWORD /d "$data64" \
                /f /reg:32 >/dev/null
            ((mirrored += 1))
        elif [[ -z $data32 && -z $data64 ]]; then
            "$wine" reg add "$key" /v "$value" /t REG_DWORD /d 1 \
                /f /reg:32 >/dev/null
            "$wine" reg add "$key" /v "$value" /t REG_DWORD /d 1 \
                /f /reg:64 >/dev/null
            ((created += 1))
        fi
    done
    printf '%s installscript_registry_markers_mirrored=%s created=%s script=%q\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$mirrored" "$created" \
        "$script_path" >> "$log"
}

install_components() {
    [[ -e $component_marker ]] && return 0

    [[ -f $dxvk/x64/dxgi.dll && -f $dxvk/x32/dxgi.dll ]] || {
        printf '%s\n' 'proton-bionic-termux: verified DXVK payload is missing' >&2
        return 1
    }
    [[ -f $vkd3d/x64/d3d12.dll && -f $vkd3d/x86/d3d12.dll ]] || {
        printf '%s\n' 'proton-bionic-termux: verified vkd3d-proton payload is missing' >&2
        return 1
    }

    if [[ ! -f $prefix/system.reg ||
          ! -f $prefix/drive_c/windows/system32/kernel32.dll ]]; then
        "$wine" wineboot -u
    fi
    install -d -m 0700 -- "$prefix/drive_c/windows/system32" \
        "$prefix/drive_c/windows/syswow64"
    install -m 0600 -- "$dxvk"/x64/*.dll "$prefix/drive_c/windows/system32/"
    install -m 0600 -- "$dxvk"/x32/*.dll "$prefix/drive_c/windows/syswow64/"
    install -m 0600 -- "$vkd3d"/x64/*.dll "$prefix/drive_c/windows/system32/"
    install -m 0600 -- "$vkd3d"/x86/*.dll "$prefix/drive_c/windows/syswow64/"
    if [[ -n $fex_payload ]]; then
        [[ -f $fex_payload/libarm64ecfex.dll && -f $fex_payload/libwow64fex.dll ]] || {
            printf '%s\n' 'proton-bionic-termux: FEX payload is incomplete' >&2
            return 1
        }
        install -m 0600 -- "$fex_payload/libarm64ecfex.dll" \
            "$fex_payload/libwow64fex.dll" "$prefix/drive_c/windows/system32/"
    fi
    printf '%s\n' "$component_version" > "$component_marker"
    printf '%s components=%s installed\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$component_version" >> "$log"
}
configure_cpu_backend() {
    local amd64_module x86_module
    case $cpu_backend in
        fex)
            amd64_module=libarm64ecfex.dll
            x86_module=libwow64fex.dll
            [[ -f $wine_root/lib/wine/aarch64-windows/$amd64_module &&
               -f $wine_root/lib/wine/aarch64-windows/$x86_module ]] || {
                printf '%s\n' 'proton-bionic-termux: installed FEX backend is incomplete' >&2
                return 1
            }
            ;;
        box64)
            amd64_module=libarm64ecfex.dll
            x86_module=wowbox64.dll
            ;;
        *)
            printf 'proton-bionic-termux: unsupported CPU backend: %s\n' "$cpu_backend" >&2
            return 1
            ;;
    esac

    export HODLL=$x86_module
    export HODLL64=$amd64_module
    printf '%s cpu_backend=%s amd64=%s x86=%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$cpu_backend" "$amd64_module" "$x86_module" >> "$log"
}


prepare_steam_compat() {
    local appid steamclient_source steamapps_dir common_link manifest_source
    local game_dir_name windows_game_root active_process_pid
    local process_name process_pid ignored
    appid=${SteamAppId:-${SteamGameId:-0}}
    [[ $appid != 0 ]] || return 0
    steamclient_source=$legacycompat/steamclient.dll
    if [[ $steam_bridge == direct && -f $lsteamclient_pe ]]; then
        steamclient_source=$lsteamclient_pe
    elif [[ $steam_bridge == legacy && -f $launch_workdir/bin/steamclient.dll ]]; then
        steamclient_source=$launch_workdir/bin/steamclient.dll
    fi

    install -d -m 0700 -- "$virtual_steam"
    # Match Proton's prefix layout even when the builtin steam.exe/lsteamclient
    # path is active. Steam DRM wrappers still inspect the registered Windows
    # Steam directory and expect the legacycompat facade to exist there.
    [[ -f $legacycompat/steamclient.dll &&
       -f $legacy_steamclient64 &&
       -f $legacycompat/Steam.dll &&
       -f $legacycompat/SteamService.exe ]] || {
        printf '%s\n' 'proton-bionic-termux: Steam legacycompat payload is missing' >&2
        return 1
    }
    install -m 0600 -- "$steamclient_source" "$virtual_steam/steamclient.dll"
    install -m 0600 -- "$legacy_steamclient64" "$virtual_steam/steamclient64.dll"
    install -m 0600 -- "$legacycompat/Steam.dll" "$virtual_steam/Steam.dll"
    install -m 0700 -- "$legacycompat/SteamService.exe" "$virtual_steam/steam.exe"
    for steam_dep in tier0_s.dll vstdlib_s.dll; do
        [[ -f $launch_workdir/bin/$steam_dep ]] || continue
        install -m 0600 -- "$launch_workdir/bin/$steam_dep" "$virtual_steam/$steam_dep"
    done

    # Present the active native Steam library below the Windows Steam path.
    # This keeps SteamPath and the game's module path on C:, as expected by
    # legacy Bethesda/Steam DRM, without copying the installed game.
    steamapps_dir=${launch_workdir%/common/*}
    common_link=$virtual_steam/steamapps/common
    if [[ $steamapps_dir != "$launch_workdir" && -d $steamapps_dir/common ]]; then
        install -d -m 0700 -- "$virtual_steam/steamapps"
        if [[ -L $common_link || ! -e $common_link ]]; then
            ln -sfn -- "$steamapps_dir/common" "$common_link"
            steam_library_mapped=1
            manifest_source=$steamapps_dir/appmanifest_$appid.acf
            if [[ -f $manifest_source ]]; then
                ln -sfn -- "$manifest_source" \
                    "$virtual_steam/steamapps/appmanifest_$appid.acf"
            fi
        else
            printf 'proton-bionic-termux: cannot map Steam common directory over %s\n' \
                "$common_link" >&2
        fi
    fi

    if [[ $steam_library_mapped == 1 && $appid == 22380 ]]; then
        game_dir_name=${launch_workdir##*/}
        windows_game_root="C:\\Program Files (x86)\\Steam\\steamapps\\common\\$game_dir_name"
        "$wine" reg add 'HKLM\Software\Bethesda Softworks\FalloutNV' /v 'Installed Path' /t REG_SZ \
            /d "$windows_game_root\\" /f /reg:32 >/dev/null
    fi

    if [[ $steam_bridge == direct || $steam_bridge == proxy ]]; then
        [[ -f $lsteamclient_pe ]] || {
            printf '%s\n' 'proton-bionic-termux: Hangover Steam proxy payload is missing' >&2
            return 1
        }
        install -d -m 0700 -- "$prefix/drive_c/windows/syswow64"
        install -m 0600 -- "$lsteamclient_pe" \
            "$prefix/drive_c/windows/syswow64/lsteamclient.dll"
        if [[ -n $steam_stub_native ]]; then
            [[ -f $steam_stub_native ]] || {
                printf '%s\n' 'proton-bionic-termux: native Steam helper is missing' >&2
                return 1
            }
            install -d -m 0700 -- "$prefix/drive_c/windows/system32"
            install -m 0700 -- "$steam_stub_native" \
                "$prefix/drive_c/windows/system32/steam.exe"
        else
            [[ -f $steam_stub ]] || {
                printf '%s\n' 'proton-bionic-termux: 32-bit Steam helper is missing' >&2
                return 1
            }
            install -m 0700 -- "$steam_stub" \
                "$prefix/drive_c/windows/syswow64/steam.exe"
        fi
    fi

    "$wine" reg add 'HKCU\Software\Valve\Steam' /v SteamPath /t REG_SZ \
        /d 'C:\Program Files (x86)\Steam' /f >/dev/null
    "$wine" reg add 'HKCU\Software\Valve\Steam' /v SteamExe /t REG_SZ \
        /d 'C:\Program Files (x86)\Steam\steam.exe' /f >/dev/null
    active_process_pid=0xfffe
    while IFS=, read -r process_name process_pid ignored; do
        process_name=${process_name//\"/}
        process_pid=${process_pid//\"/}
        process_pid=${process_pid//$'\r'/}
        if [[ $process_name == services.exe && $process_pid =~ ^[0-9]+$ ]]; then
            active_process_pid=$process_pid
            break
        fi
    done < <("$wine" tasklist /fo csv /nh 2>/dev/null)
    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v PID \
        /t REG_DWORD /d "$active_process_pid" /f >/dev/null
    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v SteamPath \
        /t REG_SZ /d 'C:\Program Files (x86)\Steam' /f >/dev/null
    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v SteamClientDll \
        /t REG_SZ /d 'C:\Program Files (x86)\Steam\steamclient.dll' /f >/dev/null
    if [[ $steam_bridge == legacy ]]; then
        "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v SteamClientDll64 \
            /t REG_SZ /d 'C:\Program Files (x86)\Steam\steamclient64.dll' /f >/dev/null
    fi

}

case $verb in
    run|runinprefix)
        start_steam_bridge
        # `run` is also used by Steam's short-lived install-script evaluator.
        # Keep the bridge alive while Wine runs, then release it so Steam does
        # not continue tracking the persistent bridge as the launched app.
        trap stop_steam_bridge EXIT
        install_components
        configure_cpu_backend
        prepare_steam_compat
        sync_installscript_registry_views "$@"
        cd -- "$launch_cwd"
        prepare_launch_args "$@"
        set +e
        # Steam's generated prerequisite evaluator launches several legacy
        # redistributables unconditionally when their VDF has no hasrunkey.
        # Those installers do not terminate reliably under Hangover. The tool
        # has already installed DXVK/vkd3d and synchronized every declared
        # marker, so acknowledge this evaluator without running its payload.
        if [[ ${1:-} == */iscriptevaluator.exe ]]; then
            status=0
        else
            "$wine" "${launch_args[@]}"
            status=$?
            # A launcher can spawn the real game as a separate Wine process
            # and exit immediately. Keep the Steam bridge alive until those
            # child processes are gone, otherwise legacy Steam DRM loses its
            # client while the game is still starting.
            "$wineserver" -w >/dev/null 2>&1 || true
        fi
        set -e
        trap - EXIT
        stop_steam_bridge
        exit "$status"
        ;;
    waitforexitandrun)
        start_steam_bridge
        # Setup failures must not leave the proxy server orphaned, otherwise
        # Steam keeps the title marked as running indefinitely.
        trap stop_steam_bridge EXIT
        install_components
        configure_cpu_backend
        prepare_steam_compat
        cd -- "$launch_cwd"
        prepare_launch_args "$@"
        configure_cpu_backend
        if [[ $steam_bridge == direct || $steam_bridge == proxy ]]; then
            "$wine" "$steam_helper" "${launch_args[@]}" >> "$log" 2>&1 &
        else
            "$wine" "${launch_args[@]}" >> "$log" 2>&1 &
        fi
        game_pid=$!
        stopped=0
        stop_session() {
            stopped=1
            kill -TERM "$game_pid" 2>/dev/null || true
        }
        trap stop_session TERM INT HUP
        set +e
        wait "$game_pid"
        status=$?
        set -e
        printf '%s game_pid=%s status=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" \
            "$game_pid" "$status" >> "$log"
        trap - TERM INT HUP
        stop_steam_bridge
        trap - EXIT
        ((stopped)) && exit 0
        exit "$status"
        ;;
    getcompatpath)
        exec "$wine" winepath -w "$@"
        ;;
    getnativepath)
        exec "$wine" winepath -u "$@"
        ;;
    destroyprefix)
        exit 0
        ;;
    *)
        printf 'proton-bionic-termux: unsupported verb: %s\n' "$verb" >&2
        exit 2
        ;;
esac
